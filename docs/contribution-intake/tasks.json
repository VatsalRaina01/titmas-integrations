{
  "kind": "LOCAL_CONTRIBUTION_TASK_DRAFTS",
  "version": "0.1",
  "status": "DRAFT_NOT_PUBLISHED",
  "claiming": "WAIT_FOR_PUBLICATION",
  "max_concurrent_tasks": 3,
  "max_tasks_per_participant": 1,
  "commands": [
    ".venv/bin/python examples/offline-review/run.py --json",
    ".venv/bin/python -m pytest titmas-python-sdk/tests tests/test_offline_review.py -q"
  ],
  "tasks": [
    {
      "id": "C01",
      "title": "在陌生环境复现中文离线样例",
      "file": "C01-clean-start.zh-CN.md",
      "allowed_paths": [
        "examples/offline-review/README.zh-CN.md",
        "docs/contribution-intake/"
      ],
      "kind": "REPRODUCTION_NOT_CONFIRMED_BUG"
    },
    {
      "id": "C02",
      "title": "为合成 SDK 响应补充一个未覆盖反例",
      "file": "C02-negative-case.zh-CN.md",
      "allowed_paths": [
        "tests/test_offline_review.py",
        "examples/offline-review/responses.json"
      ],
      "kind": "TEST_GAP_CANDIDATE"
    },
    {
      "id": "C03",
      "title": "检查并改善中文与机器结果的一致解释",
      "file": "C03-result-explanation.zh-CN.md",
      "allowed_paths": [
        "examples/offline-review/run.py",
        "examples/offline-review/README.zh-CN.md",
        "tests/test_offline_review.py"
      ],
      "kind": "USABILITY_VALIDATION"
    }
  ],
  "forbidden_paths": [
    "openapi/",
    "titmas-python-sdk/",
    "titmas-typescript-sdk/",
    "mcp/",
    ".github/workflows/"
  ],
  "restrictions": [
    "NO_REAL_CREDENTIALS",
    "NO_CUSTOMER_DATA",
    "NO_AUTOMATIC_MERGE",
    "NO_DEPLOYMENT",
    "NO_SCHEMA_OR_AUTHORITY_CHANGE"
  ]
}
