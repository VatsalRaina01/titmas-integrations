{
  "name": "@titmas/agent-sdk",
  "version": "0.1.0",
  "description": "Public-safe TypeScript client for the TITMAS Agent-native commercial candidate",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/client.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true}); require('node:fs').rmSync('dist-test', {recursive:true, force:true})\""
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
